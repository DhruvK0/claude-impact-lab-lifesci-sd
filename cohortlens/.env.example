# Copy to .env (gitignored) and fill in. Real environment variables take precedence.

# Inference through OpenRouter (default backend when this is set). Every agent seat runs on
# qwen/qwen3.7-plus unless config/agents.json -> openrouter.agents overrides a seat.
OPENROUTER_API_KEY=

# Optional: force a backend (offline | openrouter | claude). Without it: openrouter if a key is set, else offline.
# COHORTLENS_BACKEND=offline

# Optional: direct Anthropic API backend (COHORTLENS_BACKEND=claude)
# ANTHROPIC_API_KEY=

# Optional: CORS origins for the UI when it is served from elsewhere (comma separated)
# COHORTLENS_CORS_ORIGINS=http://localhost:5500

# Optional: where the UI lives if not ../cohort-lens
# COHORTLENS_UI_DIR=
