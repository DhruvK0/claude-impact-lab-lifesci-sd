{
 "$defs": {
  "AEEntry": {
   "properties": {
    "record_id": {
     "title": "Record Id",
     "type": "string"
    },
    "term": {
     "title": "Term",
     "type": "string"
    },
    "grade": {
     "title": "Grade",
     "type": "integer"
    },
    "serious": {
     "title": "Serious",
     "type": "boolean"
    },
    "relatedness": {
     "title": "Relatedness",
     "type": "string"
    },
    "onset_day": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Onset Day"
    },
    "action_taken": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Action Taken"
    },
    "visit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Visit"
    }
   },
   "required": [
    "record_id",
    "term",
    "grade",
    "serious",
    "relatedness"
   ],
   "title": "AEEntry",
   "type": "object"
  },
  "AuthorDraft": {
   "properties": {
    "author_id": {
     "title": "Author Id",
     "type": "string"
    },
    "summary": {
     "default": "",
     "title": "Summary",
     "type": "string"
    },
    "claims": {
     "items": {
      "$ref": "#/$defs/Claim"
     },
     "title": "Claims",
     "type": "array"
    },
    "proposed_routing": {
     "anyOf": [
      {
       "$ref": "#/$defs/RoutingCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "proposed_cohort_decision": {
     "anyOf": [
      {
       "$ref": "#/$defs/CohortDecisionCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "data_queries": {
     "items": {
      "$ref": "#/$defs/DataQuery"
     },
     "title": "Data Queries",
     "type": "array"
    }
   },
   "required": [
    "author_id"
   ],
   "title": "AuthorDraft",
   "type": "object"
  },
  "AuthorResponse": {
   "properties": {
    "author_id": {
     "title": "Author Id",
     "type": "string"
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ResponseItem"
     },
     "title": "Items",
     "type": "array"
    },
    "revised_routing": {
     "anyOf": [
      {
       "$ref": "#/$defs/RoutingCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "revised_cohort_decision": {
     "anyOf": [
      {
       "$ref": "#/$defs/CohortDecisionCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "author_id"
   ],
   "title": "AuthorResponse",
   "type": "object"
  },
  "CaseRecord": {
   "properties": {
    "participant_id": {
     "title": "Participant Id",
     "type": "string"
    },
    "cohort": {
     "title": "Cohort",
     "type": "integer"
    },
    "dose_level_mg": {
     "title": "Dose Level Mg",
     "type": "integer"
    },
    "blinded": {
     "default": true,
     "title": "Blinded",
     "type": "boolean"
    },
    "arm": {
     "anyOf": [
      {
       "enum": [
        "active",
        "placebo"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Arm"
    },
    "visits": {
     "items": {
      "$ref": "#/$defs/VisitEntry"
     },
     "title": "Visits",
     "type": "array"
    },
    "adverse_events": {
     "items": {
      "$ref": "#/$defs/AEEntry"
     },
     "title": "Adverse Events",
     "type": "array"
    },
    "con_meds": {
     "items": {
      "type": "string"
     },
     "title": "Con Meds",
     "type": "array"
    },
    "genomics": {
     "additionalProperties": {
      "type": "string"
     },
     "title": "Genomics",
     "type": "object"
    },
    "pathology": {
     "items": {
      "$ref": "#/$defs/Observation"
     },
     "title": "Pathology",
     "type": "array"
    },
    "data_queries": {
     "items": {
      "$ref": "#/$defs/DataQuery"
     },
     "title": "Data Queries",
     "type": "array"
    },
    "narrative": {
     "default": "",
     "title": "Narrative",
     "type": "string"
    },
    "locked": {
     "default": false,
     "title": "Locked",
     "type": "boolean"
    },
    "lock_hash": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Lock Hash"
    }
   },
   "required": [
    "participant_id",
    "cohort",
    "dose_level_mg"
   ],
   "title": "CaseRecord",
   "type": "object"
  },
  "Claim": {
   "properties": {
    "kind": {
     "description": "value=transcribed source value; derived=computed metric; count=participant count; event=adverse event; rule=stopping rule fired; routing=routing code; statement=qualitative statement backed by a quote",
     "enum": [
      "value",
      "derived",
      "count",
      "event",
      "rule",
      "routing",
      "statement"
     ],
     "title": "Kind",
     "type": "string"
    },
    "text": {
     "description": "Human-readable sentence",
     "title": "Text",
     "type": "string"
    },
    "participant_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Participant Id"
    },
    "cohort": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cohort"
    },
    "arm": {
     "anyOf": [
      {
       "enum": [
        "active",
        "placebo"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Arm"
    },
    "visit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Visit"
    },
    "field": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Analyte/vital/proteomic field or AE term",
     "title": "Field"
    },
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "unit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Unit"
    },
    "code": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Categorical value: genotype, urinalysis result, routing code",
     "title": "Code"
    },
    "metric": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "For derived/count claims: x_uln, change_from_baseline, pct_change_from_baseline, arm_mean_change, arm_mean_pct_change, arm_n, count_ae_participants",
     "title": "Metric"
    },
    "rule_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rule Id"
    },
    "grade": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "CTCAE grade (event claims) or minimum grade (count claims)",
     "title": "Grade"
    },
    "serious": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Serious"
    },
    "relatedness": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Relatedness"
    },
    "evidence": {
     "items": {
      "$ref": "#/$defs/EvidenceRef"
     },
     "title": "Evidence",
     "type": "array"
    },
    "claim_id": {
     "title": "Claim Id",
     "type": "string"
    },
    "author_id": {
     "default": "",
     "title": "Author Id",
     "type": "string"
    },
    "stage": {
     "default": "",
     "title": "Stage",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "text",
    "claim_id"
   ],
   "title": "Claim",
   "type": "object"
  },
  "ClaimVerdict": {
   "properties": {
    "claim_id": {
     "title": "Claim Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "SUPPORTED",
      "CONTRADICTED",
      "UNVERIFIED"
     ],
     "title": "Status",
     "type": "string"
    },
    "human_review": {
     "default": false,
     "title": "Human Review",
     "type": "boolean"
    },
    "checks_passed": {
     "items": {
      "type": "string"
     },
     "title": "Checks Passed",
     "type": "array"
    },
    "checks_failed": {
     "items": {
      "type": "string"
     },
     "title": "Checks Failed",
     "type": "array"
    },
    "checks_unresolved": {
     "items": {
      "type": "string"
     },
     "title": "Checks Unresolved",
     "type": "array"
    },
    "expected_value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Expected Value"
    },
    "expected_code": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Expected Code"
    },
    "diagnosis": {
     "description": "Likely cause of a mismatch, e.g. 'unit swap (/88.57)'",
     "items": {
      "type": "string"
     },
     "title": "Diagnosis",
     "type": "array"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    }
   },
   "required": [
    "claim_id",
    "status"
   ],
   "title": "ClaimVerdict",
   "type": "object"
  },
  "CohortDecisionCode": {
   "enum": [
    "ESCALATE",
    "REPEAT_DOSE",
    "DE_ESCALATE",
    "R5_PAUSE"
   ],
   "title": "CohortDecisionCode",
   "type": "string"
  },
  "CohortResult": {
   "properties": {
    "cohort": {
     "title": "Cohort",
     "type": "integer"
    },
    "dose_mg": {
     "title": "Dose Mg",
     "type": "integer"
    },
    "stage": {
     "anyOf": [
      {
       "$ref": "#/$defs/StageResult"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "agent_decision": {
     "anyOf": [
      {
       "$ref": "#/$defs/CohortDecisionCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "oracle_decision": {
     "$ref": "#/$defs/CohortDecisionCode"
    },
    "final_decision": {
     "$ref": "#/$defs/CohortDecisionCode"
    },
    "human_review": {
     "default": false,
     "title": "Human Review",
     "type": "boolean"
    },
    "human_review_reasons": {
     "items": {
      "type": "string"
     },
     "title": "Human Review Reasons",
     "type": "array"
    },
    "efficacy": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Efficacy",
     "type": "array"
    }
   },
   "required": [
    "cohort",
    "dose_mg",
    "oracle_decision",
    "final_decision"
   ],
   "title": "CohortResult",
   "type": "object"
  },
  "Critique": {
   "properties": {
    "target_claim_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Claim Id"
    },
    "target_record_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Record Id"
    },
    "target_field": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Field"
    },
    "target_visit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Visit"
    },
    "severity": {
     "enum": [
      "minor",
      "major",
      "critical"
     ],
     "title": "Severity",
     "type": "string"
    },
    "category": {
     "description": "e.g. value_mismatch, unit_error, missing_data, temporal, identity, rule_missed, overclaim, blinding",
     "title": "Category",
     "type": "string"
    },
    "assertion": {
     "title": "Assertion",
     "type": "string"
    },
    "proposed_value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Proposed Value"
    },
    "proposed_unit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Proposed Unit"
    },
    "proposed_routing": {
     "anyOf": [
      {
       "$ref": "#/$defs/RoutingCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "evidence": {
     "items": {
      "$ref": "#/$defs/EvidenceRef"
     },
     "title": "Evidence",
     "type": "array"
    },
    "critique_id": {
     "title": "Critique Id",
     "type": "string"
    },
    "reviewer_id": {
     "title": "Reviewer Id",
     "type": "string"
    },
    "reviewer_name": {
     "title": "Reviewer Name",
     "type": "string"
    },
    "planted": {
     "default": false,
     "title": "Planted",
     "type": "boolean"
    },
    "verdict": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClaimVerdict"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "severity",
    "category",
    "assertion",
    "critique_id",
    "reviewer_id",
    "reviewer_name"
   ],
   "title": "Critique",
   "type": "object"
  },
  "DataQuery": {
   "properties": {
    "query_id": {
     "title": "Query Id",
     "type": "string"
    },
    "participant_id": {
     "title": "Participant Id",
     "type": "string"
    },
    "record_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Record Id"
    },
    "field": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Field"
    },
    "visit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Visit"
    },
    "issue": {
     "title": "Issue",
     "type": "string"
    },
    "raised_by": {
     "title": "Raised By",
     "type": "string"
    },
    "status": {
     "default": "open",
     "enum": [
      "open",
      "resolved"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "query_id",
    "participant_id",
    "issue",
    "raised_by"
   ],
   "title": "DataQuery",
   "type": "object"
  },
  "EditorDecision": {
   "properties": {
    "stage": {
     "title": "Stage",
     "type": "string"
    },
    "round": {
     "title": "Round",
     "type": "integer"
    },
    "outcome": {
     "enum": [
      "ACCEPT",
      "REVISE",
      "ESCALATE"
     ],
     "title": "Outcome",
     "type": "string"
    },
    "reasons": {
     "items": {
      "type": "string"
     },
     "title": "Reasons",
     "type": "array"
    },
    "oracle_routing": {
     "anyOf": [
      {
       "$ref": "#/$defs/RoutingCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "agent_routing": {
     "anyOf": [
      {
       "$ref": "#/$defs/RoutingCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "oracle_cohort_decision": {
     "anyOf": [
      {
       "$ref": "#/$defs/CohortDecisionCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "agent_cohort_decision": {
     "anyOf": [
      {
       "$ref": "#/$defs/CohortDecisionCode"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "unresolved_critique_ids": {
     "items": {
      "type": "string"
     },
     "title": "Unresolved Critique Ids",
     "type": "array"
    },
    "lock_hash": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Lock Hash"
    }
   },
   "required": [
    "stage",
    "round",
    "outcome"
   ],
   "title": "EditorDecision",
   "type": "object"
  },
  "EvidenceRef": {
   "properties": {
    "record_id": {
     "description": "ID of an approved source record",
     "title": "Record Id",
     "type": "string"
    },
    "field": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Field inside the record's values, if any",
     "title": "Field"
    },
    "quote": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Exact excerpt copied from the record text, if citing narrative text",
     "title": "Quote"
    }
   },
   "required": [
    "record_id"
   ],
   "title": "EvidenceRef",
   "type": "object"
  },
  "HumanReviewItem": {
   "properties": {
    "item_id": {
     "title": "Item Id",
     "type": "string"
    },
    "run_id": {
     "title": "Run Id",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    },
    "participant_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Participant Id"
    },
    "cohort": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cohort"
    },
    "routing": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Routing"
    },
    "reasons": {
     "items": {
      "type": "string"
     },
     "title": "Reasons",
     "type": "array"
    },
    "status": {
     "default": "pending",
     "enum": [
      "pending",
      "confirmed",
      "overridden"
     ],
     "title": "Status",
     "type": "string"
    },
    "reviewer_decision": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reviewer Decision"
    },
    "reviewer_note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reviewer Note"
    }
   },
   "required": [
    "item_id",
    "run_id",
    "subject",
    "reasons"
   ],
   "title": "HumanReviewItem",
   "type": "object"
  },
  "Observation": {
   "properties": {
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "code": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Code"
