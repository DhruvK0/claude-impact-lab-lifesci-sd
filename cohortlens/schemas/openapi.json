 "components": {
  "schemas": {
   "ClaimContent": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "value",
       "derived",
       "count",
       "event",
       "rule",
       "routing",
       "statement"
      ],
      "title": "Kind",
      "description": "value=transcribed source value; derived=computed metric; count=participant count; event=adverse event; rule=stopping rule fired; routing=routing code; statement=qualitative statement backed by a quote"
     },
     "text": {
      "type": "string",
      "title": "Text",
      "description": "Human-readable sentence"
     },
     "participant_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Participant Id"
     },
     "cohort": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cohort"
     },
     "arm": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "active",
         "placebo"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Arm"
     },
     "visit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Visit"
     },
     "field": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Field",
      "description": "Analyte/vital/proteomic field or AE term"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     },
     "unit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Unit"
     },
     "code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Code",
      "description": "Categorical value: genotype, urinalysis result, routing code"
     },
     "metric": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Metric",
      "description": "For derived/count claims: x_uln, change_from_baseline, pct_change_from_baseline, arm_mean_change, arm_mean_pct_change, arm_n, count_ae_participants"
     },
     "rule_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Rule Id"
     },
     "grade": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Grade",
      "description": "CTCAE grade (event claims) or minimum grade (count claims)"
     },
     "serious": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Serious"
     },
     "relatedness": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Relatedness"
     },
     "evidence": {
      "items": {
       "$ref": "#/components/schemas/EvidenceRef"
      },
      "type": "array",
      "title": "Evidence"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "text"
    ],
    "title": "ClaimContent",
    "description": "What an agent asserts. Every material finding is expressed as one of these."
   },
   "ClaimVerdict": {
    "properties": {
     "claim_id": {
      "type": "string",
      "title": "Claim Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "SUPPORTED",
       "CONTRADICTED",
       "UNVERIFIED"
      ],
      "title": "Status"
     },
     "human_review": {
      "type": "boolean",
      "title": "Human Review",
      "default": false
     },
     "checks_passed": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Checks Passed"
     },
     "checks_failed": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Checks Failed"
     },
     "checks_unresolved": {
