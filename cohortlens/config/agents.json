      "effort": "medium"
    },
    "spec_labs": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "spec_vitals_ecg": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "spec_pathology": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "spec_proteomics": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "spec_genomics": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "spec_ae_meds": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "data_manager": {
      "model": "claude-opus-5-5",
