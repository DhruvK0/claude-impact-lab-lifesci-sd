{
  "_comment": "Seat models. 'openrouter' (default when OPENROUTER_API_KEY is set) runs every seat on default_model unless openrouter.agents overrides a seat; model_map translates model names used by perturbations (A3 model swap). 'agents' holds per-seat effort for all LLM backends and the models used by the direct Anthropic backend (COHORTLENS_BACKEND=claude). The architecture asks for diverse reviewer models in S3: add openrouter.agents overrides for clinical_safety / statistical / protocol_compliance to restore that.",
  "default": {
    "model": "claude-opus-5-5",
    "effort": "medium"
  },
  "agents": {
    "cra": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "sdv_reviewer": {
